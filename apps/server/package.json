{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@rafael/protocol": "workspace:*",
    "unpdf": "^1.9.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2"
  }
}
