{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --external:@google/genai --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "gen:stt-audio": "tsx scripts/gen-stt-audio.ts",
    "smoke:stt": "tsx scripts/smoke-stt.ts",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@rafael/protocol": "workspace:*",
    "unpdf": "1.9.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2"
  }
}
